/* ============================================================
   DON MADERO — Design tokens
   Palette inspired by reclaimed wood, iron hardware, dry grass
   and the rope/leather tags seen on the workshop's own pieces.
   ============================================================ */
:root {
  --walnut: #2b2016;      /* darkest wood / primary text */
  --bark: #4a3627;        /* secondary text, borders */
  --sand: #e7dcc2;        /* page background */
  --sand-dark: #dccfab;   /* section alt background */
  --cream: #faf6ec;       /* card background */
  --olive: #5b6a3f;       /* accent — campo green */
  --olive-dark: #414d2c;
  --rust: #a6531c;        /* accent — iron / rust hardware */
  --rust-dark: #7e3d12;
  --rope: #c9a866;        /* rope / wicker tan for tags */
  --iron: #2f2a24;        /* hinges, rings */
  --line: rgba(43, 32, 22, 0.16);

  --font-display: "Fraunces", serif;
  --font-body: "Work Sans", sans-serif;
  --font-tag: "JetBrains Mono", monospace;

  --radius: 3px;
  --shadow-card: 0 18px 34px -18px rgba(43, 32, 22, 0.45);
}

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
  margin: 0;
  background: var(--sand);
  color: var(--walnut);
  font-family: var(--font-body);
  font-size: 16px;
  line-height: 1.55;
  background-image:
    radial-gradient(rgba(43,32,22,0.05) 1px, transparent 1px);
  background-size: 3px 3px;
}

img { max-width: 100%; display: block; }

a { color: inherit; text-decoration: none; }

h1, h2, h3, h4 {
  font-family: var(--font-display);
  font-weight: 600;
  margin: 0 0 0.4em;
  color: var(--walnut);
  letter-spacing: -0.01em;
}

h1 { font-size: clamp(2.6rem, 5vw, 4.6rem); font-weight: 500; line-height: 1.02; }
h2 { font-size: clamp(1.8rem, 3vw, 2.6rem); }
h3 { font-size: 1.3rem; }

p { margin: 0 0 1em; }

.eyebrow {
  font-family: var(--font-tag);
  text-transform: uppercase;
  letter-spacing: 0.14em;
  font-size: 0.72rem;
  color: var(--rust-dark);
  display: inline-flex;
  align-items: center;
  gap: 0.5em;
}
.eyebrow::before {
  content: "";
  width: 18px; height: 1px;
  background: var(--rust);
  display: inline-block;
}

.container {
  max-width: 1180px;
  margin: 0 auto;
  padding: 0 6vw;
}

/* ---------------- Buttons ---------------- */
.btn {
  display: inline-flex;
  align-items: center;
  gap: 0.6em;
  font-family: var(--font-body);
  font-weight: 600;
  font-size: 0.95rem;
  padding: 0.85em 1.6em;
  border-radius: var(--radius);
  border: 1px solid transparent;
  cursor: pointer;
  transition: transform 0.15s ease, background 0.15s ease, border-color .15s ease;
}
.btn:hover { transform: translateY(-1px); }
.btn:focus-visible { outline: 3px solid var(--rust); outline-offset: 2px; }

.btn-primary { background: var(--rust); color: var(--cream); }
.btn-primary:hover { background: var(--rust-dark); }

.btn-dark { background: var(--walnut); color: var(--cream); }
.btn-dark:hover { background: #1c140d; }

.btn-outline { background: transparent; border-color: var(--walnut); color: var(--walnut); }
.btn-outline:hover { background: var(--walnut); color: var(--cream); }

.btn-whatsapp { background: var(--olive); color: var(--cream); }
.btn-whatsapp:hover { background: var(--olive-dark); }

.btn[disabled] { opacity: 0.45; cursor: not-allowed; transform: none; }

/* ---------------- Header ---------------- */
.site-header {
  position: sticky; top: 0; z-index: 40;
  background: rgba(231, 220, 194, 0.92);
  backdrop-filter: blur(6px);
  border-bottom: 1px solid var(--line);
}
.site-header .container {
  display: flex; align-items: center; justify-content: space-between;
  padding-top: 1.1em; padding-bottom: 1.1em;
}
.brand {
  font-family: var(--font-display);
  font-size: 1.5rem;
  font-weight: 600;
  display: flex; align-items: baseline; gap: 0.4em;
}
.brand small {
  font-family: var(--font-tag);
  font-size: 0.6rem;
  letter-spacing: 0.16em;
  color: var(--rust-dark);
  text-transform: uppercase;
}
.main-nav { display: flex; align-items: center; gap: 2.1em; }
.main-nav a {
  font-size: 0.92rem;
  font-weight: 500;
  color: var(--bark);
  position: relative;
  padding: 0.2em 0;
}
.main-nav a::after {
  content: ""; position: absolute; left: 0; right: 100%; bottom: -2px; height: 2px;
  background: var(--rust); transition: right .2s ease;
}
.main-nav a:hover::after, .main-nav a.active::after { right: 0; }
.main-nav a.active { color: var(--rust-dark); }

.cart-link {
  display: inline-flex; align-items: center; gap: 0.5em;
  border: 1px solid var(--walnut); padding: 0.5em 0.9em; border-radius: var(--radius);
}
.cart-count {
  font-family: var(--font-tag); font-size: 0.75rem;
  background: var(--rust); color: var(--cream);
  border-radius: 50%; min-width: 1.5em; height: 1.5em;
  display: inline-flex; align-items: center; justify-content: center;
}
.nav-toggle { display: none; }

@media (max-width: 800px) {
  .main-nav { position: fixed; inset: 64px 0 0 0; background: var(--sand); flex-direction: column;
    justify-content: flex-start; padding: 2em 6vw; gap: 1.4em; transform: translateX(100%);
    transition: transform .25s ease; }
  .main-nav.open { transform: translateX(0); }
  .nav-toggle { display: inline-flex; background: none; border: none; cursor: pointer; }
  .nav-toggle span, .nav-toggle span::before, .nav-toggle span::after {
    content: ""; display: block; width: 24px; height: 2px; background: var(--walnut); position: relative;
  }
  .nav-toggle span::before { position: absolute; top: -7px; }
  .nav-toggle span::after { position: absolute; top: 7px; }
}

/* ---------------- Hero ---------------- */
.hero {
  padding: 4.5em 0 3em;
  display: grid;
  grid-template-columns: 1.05fr 0.95fr;
  gap: 4vw;
  align-items: center;
}
.hero-copy p.lede { font-size: 1.15rem; color: var(--bark); max-width: 46ch; }
.hero-actions { display: flex; gap: 1em; margin-top: 1.6em; flex-wrap: wrap; }
.hero-figure {
  position: relative;
}
.hero-figure img {
  border-radius: var(--radius);
  box-shadow: var(--shadow-card);
}
.hero-tag {
  position: absolute;
  bottom: -22px; left: -22px;
  background: var(--cream);
  border: 1px solid var(--line);
  padding: 0.9em 1.2em;
  border-radius: var(--radius);
  box-shadow: var(--shadow-card);
  font-family: var(--font-tag);
  font-size: 0.78rem;
  max-width: 210px;
}
.hero-tag strong { display: block; font-family: var(--font-display); font-size: 1.3rem; color: var(--rust-dark); }

@media (max-width: 800px) {
  .hero { grid-template-columns: 1fr; padding-top: 2.4em; }
  .hero-tag { left: 12px; bottom: -18px; }
}

/* ---------------- Sections ---------------- */
section { padding: 4.5em 0; }
.section-alt { background: var(--sand-dark); }
.section-head { max-width: 60ch; margin-bottom: 2.4em; }

.marquee {
  border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
  padding: 1.1em 0; overflow: hidden; background: var(--walnut); color: var(--sand);
}
.marquee-track {
  display: flex; gap: 3em; white-space: nowrap; width: max-content;
  animation: scroll 26s linear infinite;
  font-family: var(--font-tag); text-transform: uppercase; letter-spacing: 0.14em; font-size: 0.8rem;
}
@keyframes scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
@media (prefers-reduced-motion: reduce) { .marquee-track { animation: none; } }

/* ---------------- Product cards / grid ---------------- */
.product-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 2.2em;
}
.product-card {
  background: var(--cream);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  overflow: hidden;
  display: flex; flex-direction: column;
  transition: transform .18s ease, box-shadow .18s ease;
}
.product-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-card); }
.product-card .thumb { aspect-ratio: 4/3; overflow: hidden; background: var(--sand-dark); }
.product-card .thumb img { width: 100%; height: 100%; object-fit: cover; }
.product-card .body { padding: 1.3em 1.3em 1.6em; display: flex; flex-direction: column; flex: 1; }
.product-card .cat { font-family: var(--font-tag); font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--olive-dark); }
.product-card h3 { margin-top: 0.3em; }
.product-card .row { margin-top: auto; display: flex; align-items: center; justify-content: space-between; padding-top: 1em; }

/* rope price tag — the signature detail */
.price-tag {
  font-family: var(--font-tag);
  font-size: 1.05rem;
  color: var(--walnut);
  position: relative;
  padding-left: 1.6em;
}
.price-tag::before {
  content: "";
  position: absolute; left: 0; top: 50%; transform: translateY(-50%);
  width: 1.1em; height: 1.1em;
  border-radius: 50%;
  border: 2px solid var(--rope);
  background: transparent;
}

.coming-note {
  border: 1px dashed var(--line);
  border-radius: var(--radius);
  padding: 1.6em;
  font-family: var(--font-tag);
  font-size: 0.85rem;
  color: var(--bark);
  text-align: center;
  background: var(--cream);
}

/* ---------------- Product detail ---------------- */
.product-detail {
  display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 4vw; align-items: start;
}
.gallery-main { border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow-card); margin-bottom: 0.8em; }
.gallery-main img { width: 100%; aspect-ratio: 4/3; object-fit: cover; }
.gallery-thumbs { display: flex; gap: 0.7em; }
.gallery-thumbs button {
  border: 2px solid transparent; padding: 0; background: none; cursor: pointer; border-radius: var(--radius); overflow: hidden;
  width: 84px; aspect-ratio: 4/3;
}
.gallery-thumbs button.active { border-color: var(--rust); }
.gallery-thumbs img { width: 100%; height: 100%; object-fit: cover; }

.detail-price { font-family: var(--font-tag); font-size: 2rem; color: var(--rust-dark); margin: 0.3em 0 1em; }
.feature-list { list-style: none; padding: 0; margin: 1.2em 0; display: grid; gap: 0.6em; }
.feature-list li { display: flex; gap: 0.7em; align-items: baseline; }
.feature-list li::before { content: "—"; color: var(--olive-dark); font-weight: 700; }

.qty-row { display: flex; align-items: center; gap: 1em; margin: 1.6em 0; }
.qty-control { display: inline-flex; border: 1px solid var(--walnut); border-radius: var(--radius); overflow: hidden; }
.qty-control button { background: var(--cream); border: none; width: 2.4em; height: 2.4em; font-size: 1.1rem; cursor: pointer; }
.qty-control input { width: 3em; text-align: center; border: none; border-left: 1px solid var(--line); border-right: 1px solid var(--line); font-family: var(--font-tag); }

@media (max-width: 800px) { .product-detail { grid-template-columns: 1fr; } }

/* ---------------- Cart page ---------------- */
.cart-table { width: 100%; border-collapse: collapse; }
.cart-table th { text-align: left; font-family: var(--font-tag); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--bark); padding-bottom: 0.8em; border-bottom: 1px solid var(--line); }
.cart-table td { padding: 1.2em 0.4em; border-bottom: 1px solid var(--line); vertical-align: middle; }
.cart-item-info { display: flex; gap: 1em; align-items: center; }
.cart-item-info img { width: 76px; height: 76px; object-fit: cover; border-radius: var(--radius); }
.remove-link { font-family: var(--font-tag); font-size: 0.75rem; color: var(--rust-dark); background: none; border: none; cursor: pointer; text-decoration: underline; }
.cart-summary { max-width: 380px; margin-left: auto; margin-top: 2em; border-top: 2px solid var(--walnut); padding-top: 1.2em; }
.cart-summary .total-row { display: flex; justify-content: space-between; font-family: var(--font-tag); font-size: 1.3rem; margin-bottom: 1.2em; }
.empty-cart { text-align: center; padding: 4em 0; }

/* ---------------- Footer ---------------- */
.site-footer { background: var(--walnut); color: var(--sand); padding: 3.5em 0 2em; margin-top: 3em; }
.footer-grid { display: grid; grid-template-columns: 1.3fr 1fr 1fr; gap: 3em; }
.site-footer h4 { color: var(--sand); font-family: var(--font-body); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 1em; }
.site-footer a, .site-footer p { color: rgba(231, 220, 194, 0.78); font-size: 0.92rem; }
.site-footer a:hover { color: var(--sand); }
.footer-bottom { border-top: 1px solid rgba(231,220,194,0.18); margin-top: 2.5em; padding-top: 1.5em; font-size: 0.78rem; color: rgba(231,220,194,0.55); display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1em; }
@media (max-width: 700px) { .footer-grid { grid-template-columns: 1fr; } }

.wa-float {
  position: fixed; right: 1.4em; bottom: 1.4em; z-index: 50;
  background: var(--olive); color: var(--cream);
  width: 3.4em; height: 3.4em; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  box-shadow: var(--shadow-card);
}
.wa-float:hover { background: var(--olive-dark); }

/* ---------------- Misc pages ---------------- */
.page-hero { padding: 3em 0 1em; }
.two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 4vw; align-items: center; }
@media (max-width: 800px) { .two-col { grid-template-columns: 1fr; } }

.contact-card { background: var(--cream); border: 1px solid var(--line); border-radius: var(--radius); padding: 2em; }
.contact-card dt { font-family: var(--font-tag); font-size: 0.7rem; text-transform: uppercase; color: var(--olive-dark); letter-spacing: 0.08em; }
.contact-card dd { margin: 0 0 1.2em; font-size: 1.05rem; }

.toast {
  position: fixed; left: 50%; bottom: 2em; transform: translate(-50%, 20px);
  background: var(--walnut); color: var(--sand); padding: 0.9em 1.4em; border-radius: var(--radius);
  font-size: 0.9rem; opacity: 0; pointer-events: none; transition: all .25s ease;
  font-family: var(--font-tag);
}
.toast.show { opacity: 1; transform: translate(-50%, 0); }
